{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "caridana-filkom",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
